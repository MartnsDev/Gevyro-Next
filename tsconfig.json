{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "outDir": ".test-build",
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": [],
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
