# Configure no BACKEND, no gerenciador de segredos do deploy.
# Este arquivo é apenas um modelo: Spring não importa .env automaticamente.
# Não copie credenciais para o frontend nem para variáveis NEXT_PUBLIC_.
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
APP_FRONTEND_URL=https://gevyro.com.br
# Após validar credenciais, URLs, webhook, Redis, banco e homologação:
# MERCADO_PAGO_ENABLED=true
